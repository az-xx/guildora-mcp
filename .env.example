# Copy this file to .env and fill in your own values. Never commit .env.
# (.env is only read by `npm run test:live`; MCP clients pass these as environment variables.)

# Required: the bot token from the Discord Developer Portal (Bot > Reset Token).
DISCORD_TOKEN=your-bot-token-here

# Optional: default server ID, so tools can omit the "guild" argument.
DISCORD_GUILD_ID=

# Optional: comma-separated packs to enable (default: core). Use "all" for everything.
# Packs: core, channels, roles, moderation, threads, voice, webhooks, invites, emoji
GUILDORA_PACKS=core

# Optional: "true" exposes only tools that do not change anything.
GUILDORA_READ_ONLY=false

# Optional: "stdio" (default) or "http".
GUILDORA_TRANSPORT=stdio

# Optional HTTP settings (GUILDORA_TRANSPORT=http).
GUILDORA_HOST=127.0.0.1
GUILDORA_PORT=8085
# Require "Authorization: Bearer <token>"; use a long random value (16+ characters).
GUILDORA_HTTP_TOKEN=

# Optional: max messages scanned when Discord's server search is unavailable (100-10000).
GUILDORA_SCAN_LIMIT=1000

# Optional: error, warn, info or debug. Logs go to stderr only.
GUILDORA_LOG_LEVEL=info

# Live smoke test only (npm run test:live). Use a throwaway test server.
GUILDORA_TEST_GUILD_ID=
GUILDORA_TEST_CHANNEL_ID=
